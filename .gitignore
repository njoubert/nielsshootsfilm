# Experimental
experimental/

# Dependencies - node_modules is excluded, but .pnpm-store is vendored
node_modules/
frontend/node_modules/
# Note: frontend/.pnpm-store/ is NOT ignored - it's vendored for hermetic builds

# Build outputs
dist/
build/
build-bin/
bazel-*/
coverage/
*.coverage
backend/coverage.html
backend/coverage.out

# TypeScript compilation artifacts (should not be committed)
frontend/src/**/*.js
frontend/src/**/*.js.map

# Bazel user configuration
.bazelrc.user

# Environment variables
env
env.local
env.*.local
*env

# Secrets
*.pem
*.key
*.cert
credentials.json
secrets.yaml
admin_config.json

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Server runtime files
*.pid
server.pid
server.log

# Uploaded content (for local dev)
static/uploads/*
!static/uploads/.gitkeep
!static/uploads/originals/.gitkeep
!static/uploads/display/.gitkeep
!static/uploads/thumbnails/.gitkeep

# Data files (for local dev)
data/*.json
!data/.gitkeep

# Backup files
.backups/
*.backup
*.bak

# Test artifacts
*.test
*.out

# Go build artifacts
*.exe
*.dll
*.so
*.dylib
backend/bin/

# Temporary files
tmp/
temp/

# Docker artifacts
*.tar
